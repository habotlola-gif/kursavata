{
  "schemaVersion": 1,
  "id": "hatek_client",
  "version": "${version}",

  "name": "Hatek Client",
  "description": "",
  "authors": [],
  "contact": {},

  "license": "All-Rights-Reserved",
  "icon": "assets/hatek_client/icon.png",

  "environment": "client",
  "entrypoints": {
